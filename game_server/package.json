{
  "private": true,
  "name": "kartfall-server",
  "version": "0.17.0",
  "description": "npm init template for bootstrapping an empty Colyseus project",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 20.9.0"
  },
  "scripts": {
    "start": "node build/index.js",
    "dev": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room kartfall_room --numClients 2",
    "yellow:bootstrap": "tsx src/scripts/bootstrap-yellow.ts",
    "build": "npm run clean && node --max-old-space-size=2048 ./node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "clean": "rm -rf build",
    "test": "mocha -r tsx test/**.test.ts --exit --timeout 15000"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/colyseus/create-colyseus/issues"
  },
  "homepage": "https://github.com/colyseus/create-colyseus#readme",
  "devDependencies": {
    "@colyseus/loadtest": "^0.17.7",
    "@colyseus/sdk": "^0.17.17",
    "@colyseus/testing": "^0.17.10",
    "@types/express": "^4.17.1",
    "@types/mocha": "^10.0.1",
    "mocha": "^11.7.5"
  },
  "dependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.0.4",
    "@colyseus/bun-websockets": "^0.17.9",
    "@colyseus/schema": "^4.0.0",
    "@colyseus/tools": "^0.17.0",
    "@erc7824/nitrolite": "^0.5.3",
    "@privy-io/node": "^0.10.1",
    "@supabase/supabase-js": "^2.99.1",
    "@yellow-org/sdk": "^1.2.0",
    "colyseus": "^0.17.6",
    "decimal.js": "^10.6.0",
    "express": "^4.18.2"
  }
}
